# Copy to .env and adjust. In production NODE_ENV=production enforces JWT_SECRET and CLIENT_ORIGIN.
NODE_ENV=development
PORT=4000

# At least 32 random characters in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma separated; these accounts get the admin role
ADMIN_EMAILS=marija.stankovska@yahoo.com

# Frontend URL(s) allowed by CORS and websockets, comma separated (must be set in production),
# e.g. https://beautyqueen.mk,https://www.beautyqueen.mk  (the Expo/mobile app doesn't need an entry)
CLIENT_ORIGIN=*

# ---- Account verification (6-digit codes for registration and forgotten password) ----
# Production refuses to start unless e-mail (SMTP_*) and/or SMS (TWILIO_*) is configured.
# Without them in development, codes are printed in this console and shown in the app.

# E-mail via any SMTP provider. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords>
# For real production volume prefer Brevo / Mailgun / Amazon SES / Resend (better deliverability).
SMTP_HOST=
SMTP_PORT=587
# true for port 465; leave empty to auto-detect from the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Beauty Queen <no-reply@beautyqueen.mk>"

# Optional SMS via Twilio (users can then choose "SMS" when registering).
# TWILIO_FROM: a Twilio number (+1...), an alphanumeric sender ("BeautyQ") or a Messaging Service SID (MG...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Where users/appointments/notifications JSON and uploads/ are stored (default: this folder).
# Point it at a persistent, backed-up volume in production.
DATA_DIR=

# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…) so rate limiting sees real client IPs
TRUST_PROXY=

TZ=Europe/Skopje

# Optional — generated automatically into $DATA_DIR/vapid.json on first start if omitted.
# Keep them stable: changing them invalidates every push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
