# Copy to .env and adjust for production
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# Comma separated; these accounts get the admin role
ADMIN_EMAILS=marija.stankovska@yahoo.com
# Frontend origin allowed by CORS / websockets (use * for local development)
CLIENT_ORIGIN=*
TZ=Europe/Skopje
# Optional — generated automatically into vapid.json on first start if omitted
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
